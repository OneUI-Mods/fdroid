        "authorName": "ryuya0124",
        "authorWebSite": "https://github.com/ryuya0124",
        "summary": {
          "en-US": "Dark themes for supported apps"
        },
        "description": {
          "en-US": "<p>Adds system, light and dark appearance options to supported versions of SESAME and povo. Requires root and a libxposed API 102 compatible framework such as Vector. The supported host apps are proprietary; they are not bundled.</p>"
