        "authorName": "ryuya0124",
        "authorWebSite": "https://github.com/ryuya0124",
        "summary": {
          "en-US": "Extend supported Samsung camera apps"
        },
        "description": {
          "en-US": "<p>Optional camera preview, lens transition and camera capability adjustments for supported Samsung Camera, Camera Assistant and Expert RAW versions. Requires root and a libxposed API 102 compatible framework. Hardware and firmware limits still apply; unsupported modes are not guaranteed.</p>"
