    "dev.ryuya.galaxybar": {
      "metadata": {
        "authorName": "ryuya0124",
        "authorWebSite": "https://github.com/ryuya0124",
        "summary": {
          "en-US": "Adapt status bar colors to the background"
        },
        "description": {
          "en-US": "<p>Adjusts clock text and status icons to the background on supported Galaxy firmware, with configurable fades, app transition tracking and privacy indicator motion. Requires root and a libxposed API 102 compatible framework. Android 16 and 17 support is firmware specific.</p>"
