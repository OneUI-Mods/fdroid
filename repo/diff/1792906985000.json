    "dev.ryuya.galaxyupdateguard": {
      "metadata": {
        "authorName": "ryuya0124",
        "authorWebSite": "https://github.com/ryuya0124",
        "summary": {
          "en-US": "Pause and restore Galaxy OS updates"
        },
        "description": {
          "en-US": "<p>Disables supported Samsung OS update services and restores their previous state. Requires root. Google Play system and application updates are outside its scope. Restore the original state before uninstalling or clearing this app's data.</p>"
