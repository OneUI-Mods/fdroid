        "authorWebSite": "https://github.com/ryuya0124",
        "name": {
          "en-US": "HomePod Bridge"
        },
        "summary": {
          "en-US": "Stream Android playback to HomePod"
        },
        "description": {
          "en-US": "<p>Stream selected-app media or device playback and notification sounds to HomePod over AirPlay 2. Requires root and a compatible Xposed framework such as Vector enabled for System UI. Microphone and call audio are excluded. Includes adjustable latency and buffer controls. HomePod and its proprietary receiver firmware are not bundled. See the source README for supported devices and setup.</p>"
        },
